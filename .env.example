# Copy to .env and fill in. Never commit the real .env file.

# Create an app at https://developer.spotify.com/dashboard
# Add http://127.0.0.1:8080/callback as a Redirect URI on the app.
# Enable "Web API" on the app.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Optional. ReccoBeats' free tier currently needs no key — leave blank
# unless/until that changes. Check https://reccobeats.com/docs for current status.
RECCOBEATS_API_KEY=
